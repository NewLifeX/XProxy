<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XProxy</AssemblyName>
    <AssemblyTitle>XProxy Proxy Server</AssemblyTitle>
    <Description>Proxy server host for NAT reverse proxy and HTTP forward/reverse proxy.</Description>
    <Company>新生命开发团队</Company>
    <Copyright>版权所有(C) 新生命开发团队 2002~2026</Copyright>
    <VersionPrefix>3.2</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Server</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- net8.0+ 常驻启用 AOT/裁剪分析器，0 告警作为构建期约束 -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Base\**" />
    <Compile Remove="Config\**" />
    <Compile Remove="Http\Plugin\**" />
    <Compile Remove="Plugin\**" />
    <Compile Remove="Proxy\Socks5\**" />
    <EmbeddedResource Remove="Base\**" />
    <EmbeddedResource Remove="Config\**" />
    <EmbeddedResource Remove="Http\Plugin\**" />
    <EmbeddedResource Remove="Plugin\**" />
    <EmbeddedResource Remove="Proxy\Socks5\**" />
    <None Remove="Base\**" />
    <None Remove="Config\**" />
    <None Remove="Http\Plugin\**" />
    <None Remove="Plugin\**" />
    <None Remove="Proxy\Socks5\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ByteHelper.cs" />
    <Compile Remove="Http\HttpBase.cs" />
    <Compile Remove="Http\HttpCache.cs" />
    <Compile Remove="Http\HttpHelper.cs" />
    <Compile Remove="Http\HttpPlugin.cs" />
    <Compile Remove="Http\HttpPluginBase.cs" />
    <Compile Remove="Http\HttpRequest.cs" />
    <Compile Remove="Http\HttpResponse.cs" />
    <Compile Remove="Http\IHttpPlugin.cs" />
    <Compile Remove="NetData.cs" />
    <Compile Remove="NetHelper.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1021-beta0321" />
    <PackageReference Include="NewLife.Agent" Version="10.18.2026.1013-beta0145" />
    <!-- 由 Stardust 间接使用，显式升级到最新 beta -->
    <PackageReference Include="NewLife.Remoting" Version="3.9.2026.1022-beta0147" />
    <PackageReference Include="NewLife.Stardust" Version="3.10.2026.1021-beta0432" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <ItemGroup>
      <XmlDocs Include="$(TargetDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(XmlDocs)" />
  </Target>

</Project>
